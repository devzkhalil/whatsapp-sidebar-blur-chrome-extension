{
    "name": "WhatsApp Sidebar Blur",
    "description": "Minimize distractions and safeguard your privacy with WhatsApp Sidebar Blur. This clever feature blurs chat previews, keeping your focus on the current conversation and hiding sensitive info from view in public settings. Enjoy a calmer, more private WhatsApp experience.",
    "version": "1.0",
    "manifest_version": 3,
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "tabs",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "https://web.whatsapp.com/"
    ],
    "content_scripts": [
        {
            "matches": ["https://web.whatsapp.com/*"],
            "css": ["voice-to-text.css"],
            "js": ["voice-to-text.js"],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    }
}
